# Copy this file to .env and replace values for the target environment.
# Never commit a real TOKEN_SECRET or business-system credentials.

# Optional override. Leave empty to generate and reuse DATA_DIR/.token-secret.
TOKEN_SECRET=

# LegalAI backend reachable from the editor container on the same Docker network.
# Include the backend context path; keep {docId} for the actual contract ID.
BUSINESS_API_BASE_URL=http://legalai-backend:8080/legalai
BUSINESS_DOCUMENT_CONTENT_PATH=/doc-editor/{docId}/content

# LegalAI uses token; other integrations must set their own header name.
BUSINESS_TOKEN_HEADER=token

# Host path mounted into /app/data. For /opt/docflow/services, use ../data.
HOST_DATA_DIR=../data
