# Copy this file to .env and replace values for the target environment.
# Never commit a real TOKEN_SECRET or business-system credentials.

# Required: generate a different random value for each environment.
# Example: openssl rand -hex 32
TOKEN_SECRET=replace-with-a-random-64-character-hex-secret

# Required: business backend reachable from the editor container.
BUSINESS_API_BASE_URL=https://api.example.com
BUSINESS_DOCUMENT_CONTENT_PATH=/integration/documents/{docId}/content

# Optional: defaults to X-Editor-Token when omitted.
BUSINESS_TOKEN_HEADER=X-Editor-Token

# Host path mounted into /app/data. For /opt/docflow/services, use ../data.
HOST_DATA_DIR=../data
